#!/usr/bin/env ruby

# This file is a replacement for the `mailcatcher` command.
# It allows to use environment variables from dotenv files
#
require "dotenv"

env = ENV.fetch("DOTENV", "development")
Dotenv.load(
  ".env.development.local",
  (".env.local" unless env == "test"),
  ".env.#{env}",
  ".env"
)

smtp_port = ENV.fetch("SMTP_PORT", 1025)

# Inside Docker, listen on all interfaces so the web interface
# is reachable from the host through the published port.
ip_option = " --ip 0.0.0.0" if ENV["DOCKER"]

system("mailcatcher#{ip_option} --foreground --smtp-port #{smtp_port}")
